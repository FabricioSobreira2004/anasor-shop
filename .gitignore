# Dependências (reinstaladas com "npm install" dentro de backend/)
node_modules/

# Variáveis de ambiente com credenciais reais (Mercado Pago em produção) —
# backend/.env já tinha seu próprio .gitignore, isso aqui é um segundo
# cinto de segurança na raiz do repositório.
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Pasta "site mãe" (fotos/vídeos brutos do WhatsApp, materiais de referência) —
# nunca deve entrar no repositório do site, mesmo que algum dia seja
# copiada/colada para dentro desta pasta por engano.
/site-mae/
/site mae/

# Arquivos compactados (originais de mídia, nunca pertencem ao código do site)
*.zip
*.rar

# Vercel (criado localmente pelo "vercel link"/"vercel dev", específico da máquina)
.vercel

# Sistema
.DS_Store
Thumbs.db
desktop.ini

# Artes do Instagram: geradas por marketing/instagram/gerar-posts.js
# direto em E:\projetos\site-mae\instagram-posts\ (fora deste repo, nunca
# aparece aqui) — regeneradas em qualquer PC a partir do repositório, não
# precisam de versão. folha-contato.png é a ferramenta de revisão em lote
# (marketing/instagram/folha-contato.js), também gerada, nunca comitada.
/marketing/instagram/posts/
/marketing/instagram/folha-contato.png

# Capas dos destaques (marketing/instagram/gerar-capas-destaque.js): mesmo
# motivo acima — geradas, pesadas (PNGs 1080x1920/1080x1080), 100%
# reproduzíveis rodando o script. Ficam DENTRO do repositório (pedido
# explícito desta rodada, diferente de instagram-posts/), só não vão
# para o git.
/marketing/instagram/destaques/

# Prints das verificações com Playwright: ficam no projeto (sem precisar de
# permissão para ler fora dele), mas nunca vão para o git.
/_prints/
